<Project Sdk="Microsoft.NET.Sdk">

  <!-- Установщик на .NET Framework 4.8: он встроен в Windows 10/11, так что setup.exe запускается
       без доустановки чего-либо. Сама программа внутри — со своей средой .NET (self-contained). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\TunPilot\app.ico</ApplicationIcon>
    <AssemblyName>TunPilotSetup</AssemblyName>
    <RootNamespace>TunPilotSetup</RootNamespace>
    <Version>1.0.1</Version>
    <Product>TunPilot</Product>
    <AssemblyTitle>Установка TunPilot</AssemblyTitle>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="payload.zip" LogicalName="payload.zip" Condition="Exists('payload.zip')" />
    <EmbeddedResource Include="payload-arch.txt" LogicalName="payload-arch.txt" Condition="Exists('payload-arch.txt')" />
    <EmbeddedResource Include="..\TunPilot\app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
