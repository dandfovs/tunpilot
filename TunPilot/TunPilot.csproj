<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Debug — без запроса прав администратора (UAC): для скриншотов и самопроверок при разработке. VPN в ней не подключится. -->
    <ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.dev.manifest</ApplicationManifest>
    <RootNamespace>TunPilot</RootNamespace>
    <AssemblyName>TunPilot</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <Product>TunPilot</Product>
    <Company>TunPilot</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TunPilot.Core\TunPilot.Core.csproj" />
    <Using Include="TunPilot.Loc" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- ядра — отдельными файлами рядом с exe (не внутрь single-file: их запускают как процессы) -->
    <None Include="cores\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
